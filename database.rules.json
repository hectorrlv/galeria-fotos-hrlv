{
  "rules": {
    "photoLikes": {
      "$photoId": {
        ".validate": "newData.hasChild('count') && newData.child('count').isNumber() && newData.child('count').val() >= 0 && newData.child('count').val() % 1 === 0 && (auth.uid === 'tt6Vtlpd7rfbX8F9ZSj2yqTyJTV2' || newData.child('count').val() === (data.child('count').exists() ? data.child('count').val() : 0) + (newData.child('voters').child(auth.uid).exists() ? 1 : 0) - (data.child('voters').child(auth.uid).exists() ? 1 : 0))",
        "count": {
          ".read": true,
          ".write": "auth != null && newData.isNumber() && (data.exists() || newData.parent().child('voters').child(auth.uid).exists())"
        },
        "voters": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "auth.uid === 'tt6Vtlpd7rfbX8F9ZSj2yqTyJTV2' || (newData.hasChild('albumId') && newData.child('albumId').isString() && root.child('public/albums').child(newData.child('albumId').val()).child('status').val() === 'published' && root.child('public/albums').child(newData.child('albumId').val()).child('photos').child($photoId).child('visible').val() === true && !root.child('private/photoDeletions').child($photoId).exists())",
            "albumId": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "public": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'tt6Vtlpd7rfbX8F9ZSj2yqTyJTV2'",
      "albums": {
        "$albumId": {
          ".validate": "newData.val() == null || (newData.hasChildren(['id', 'slug', 'title', 'status', 'photos', 'photoOrder']) && newData.child('id').val() === $albumId && newData.child('status').val() === 'published')",
          "photos": {
            "$photoId": {
              ".validate": "!newData.hasChild('originalPath')"
            }
          }
        }
      }
    },
    "private": {
      ".read": "auth != null && auth.uid === 'tt6Vtlpd7rfbX8F9ZSj2yqTyJTV2'",
      ".write": "auth != null && auth.uid === 'tt6Vtlpd7rfbX8F9ZSj2yqTyJTV2'",
      "albums": {
        "$albumId": {
          ".validate": "newData.val() == null || newData.parent().parent().child('schemaVersion').val() !== 2 || (!newData.hasChild('photos') && newData.child('id').val() === $albumId)",
          "photoRefs": {
            "$photoId": {
              ".validate": "newData.hasChild('visible') && newData.child('visible').isBoolean() && newData.parent().parent().parent().parent().child('photos').child($photoId).exists()"
            }
          }
        }
      },
      "photos": {
        "$photoId": {
          ".validate": "newData.val() == null || (newData.child('id').val() === $photoId && !newData.hasChild('albumId') && !newData.hasChild('visible'))"
        }
      }
    },
    ".read": "auth != null && auth.uid === 'tt6Vtlpd7rfbX8F9ZSj2yqTyJTV2'",
    ".write": "auth != null && auth.uid === 'tt6Vtlpd7rfbX8F9ZSj2yqTyJTV2'"
  }
}
