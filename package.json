{
  "name": "galeria-fotos-hrlv",
  "version": "0.1.0",
  "private": true,
  "description": "Galería fotográfica personal de viajes y paseos.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.13.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "pnpm run build && web-dev-server --root-dir dist --app-index dist/index.html --port 8000",
    "start:e2e": "FIREBASE_CONFIG_DISABLED=1 pnpm run build && web-dev-server --root-dir dist --app-index dist/index.html --port 8017",
    "build": "rimraf dist && rollup -c rollup.config.js",
    "typecheck": "tsc6 --noEmit",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "firebase": "^12.16.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.2",
    "@types/node": "^26.1.2",
    "@web/dev-server": "^1.0.0",
    "@web/rollup-plugin-html": "^4.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.3.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
